vid:start-recorder
user-message "Press OK to start recording, press STOP on the video recorder when done."
set recording true</button>
    <note x="300" y="1147" backgroundDark="0" fontSize="12" width="105" markdown="false" height="18" textColorDark="-1" textColorLight="-2674135" backgroundLight="0">VIDEO RECORDER</note>
    <note x="435" y="766" backgroundDark="0" fontSize="11" width="80" markdown="false" height="75" textColorDark="-1" textColorLight="-2674135" backgroundLight="0">Always save as a behavior after changes in this section!</note>
    <note x="480" y="1108" backgroundDark="0" fontSize="11" width="115" markdown="false" height="70" textColorDark="-1" textColorLight="-2674135" backgroundLight="0">This behavior is used to initialize the census model. Pick the most common or typical.</note>
    <input x="260" multiline="false" y="345" height="60" variable="fish.color" type="color" width="180">9.9</input>
    <chooser x="317" y="410" height="60" variable="prey.type" current="0" width="210" display="prey.type">
      <choice type="string" value="benthic"></choice>
      <choice type="string" value="fish"></choice>
    </chooser>
    <button x="260" y="610" height="45" disableUntilTicks="false" forever="false" kind="Observer" width="130">setup</button>
    <button x="400" y="610" height="45" disableUntilTicks="false" forever="true" kind="Observer" width="130">go</button>
    <button x="430" y="530" height="60" disableUntilTicks="false" forever="false" kind="Observer" width="101" display="Estimate">estimate-speeds</button>
    <input x="315" multiline="false" y="530" height="60" variable="aspect.ratio" type="number" width="110">3.0</input>

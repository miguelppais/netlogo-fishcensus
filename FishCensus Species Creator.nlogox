    <slider x="15" step="0.5" y="609" max="20" width="240" display="id.distance" height="50" min="0.5" direction="Horizontal" default="4.0" variable="id.distance" units="meters"></slider>
    <monitor x="260" precision="0" y="170" height="60" fontSize="11" width="155" display="Nr. fishes">count fishes</monitor>
    <slider x="170" step="0.05" y="1287" max="1" width="150" display="b1.freq" height="50" min="0" direction="Horizontal" default="0.5" variable="b1.freq"></slider>
    <slider x="170" step="0.05" y="1364" max="1" width="150" display="b2.freq" height="50" min="0" direction="Horizontal" default="0.2" variable="b2.freq"></slider>
    <slider x="170" step="0.05" y="1441" max="1" width="150" display="b3.freq" height="50" min="0" direction="Horizontal" default="0.3" variable="b3.freq"></slider>
    <slider x="170" step="0.05" y="1518" max="1" width="150" display="b4.freq" height="50" min="0" direction="Horizontal" default="0.0" variable="b4.freq"></slider>
    <monitor x="20" precision="2" y="1197" height="60" fontSize="11" width="245" display="Sum of frequencies (must be 1)">b1.freq + b2.freq + b3.freq + b4.freq</monitor>
    <slider x="250" step="0.1" y="711" max="1" width="172" display="detectability" height="50" min="0" direction="Horizontal" default="1.0" variable="detectability"></slider>
    <note x="20" y="671" backgroundDark="0" fontSize="11" width="500" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">BEHAVIOR PARAMETERS______________________________________________________________</note>
    <monitor x="20" precision="17" y="1132" height="60" fontSize="11" width="245" display="Current behavior">loaded.behavior</monitor>
    <slider x="250" step="1" y="931" max="50" width="172" display="prey.chasing.w" height="50" min="0" direction="Horizontal" default="0.0" variable="prey.chasing.w"></slider>
    <note x="270" y="1182" backgroundDark="0" fontSize="11" width="155" markdown="false" height="41" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">To save an empty behavior, simply set frequency to 0 and save.</note>
    <button x="435" y="951" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="75" display="Pick patch">pick.patch</button>
    <slider x="250" step="1" y="821" max="20" width="172" display="rest.w" height="50" min="0" direction="Horizontal" default="0.0" variable="rest.w"></slider>
    <monitor x="212" precision="2" y="423" height="60" fontSize="11" width="100" display="L/s">max.sustained.speed / fish.size</monitor>
    <slider x="15" step="0.1" y="492" max="10" width="190" display="burst.speed" height="50" min="0" direction="Horizontal" default="2.6" variable="burst.speed" units="m/s"></slider>
    <monitor x="210" precision="1" y="488" height="60" fontSize="11" width="100" display="L/s">burst.speed / fish.size</monitor>
    <slider x="250" step="1" y="876" max="10" width="172" display="cruise.w" height="50" min="0" direction="Horizontal" default="0.0" variable="cruise.w"></slider>
    <chooser x="425" y="170" height="60" variable="csv.delimiter" current="0" width="100" display="csv.delimiter">
      <choice type="string" value=","></choice>
      <choice type="string" value=";"></choice>
    </chooser>
    <button x="445" y="345" height="60" disableUntilTicks="false" forever="false" kind="Observer" width="80" display="paint fishes">ask fishes [set color fish.color]</button>
    <note x="195" y="1018" backgroundDark="0" fontSize="11" width="55" markdown="false" height="40" textColorDark="-1" textColorLight="-2674135" backgroundLight="0">set to negative if attracted</note>
    <button x="470" y="1008" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="STOP">set recording FALSE
vid:save-recording _recording-save-file-name

set schoolmate-counts lput (count other fishes in-radius school.size.reference.radius) schoolmate-counts
]
output-print (word "Average school size is " precision (mean schoolmate-counts) 0 " +/- " precision (standard-deviation schoolmate-counts) 0)]]></button>
